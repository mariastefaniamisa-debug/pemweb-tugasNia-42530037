<%- include('../partials/header', { pageTitle: pageTitle }) %>

<div class="card form-card">
  <h2>Edit Buku #<%= buku.id %></h2>
  <form action="/buku/edit/<%= buku.id %>" method="POST">
    <div class="field">
      <label for="judul">Judul</label>
      <input type="text" id="judul" name="judul" value="<%= buku.judul %>" maxlength="150" required>
    </div>
    <div class="field">
      <label for="penulis">Penulis</label>
      <input type="text" id="penulis" name="penulis" value="<%= buku.penulis %>" maxlength="100" required>
    </div>
    <div class="field">
      <label for="sinopsis">Sinopsis</label>
      <textarea id="sinopsis" name="sinopsis" rows="4"><%= buku.sinopsis %></textarea>
    </div>
    <div class="field">
      <label for="harga_sewa">Harga Sewa (Rp)</label>
      <input type="number" id="harga_sewa" name="harga_sewa" value="<%= buku.harga_sewa %>" min="0" step="500" required>
    </div>
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status" required>
        <option value="tersedia" <%= buku.status === 'tersedia' ? 'selected' : '' %>>Tersedia</option>
        <option value="dipinjam" <%= buku.status === 'dipinjam' ? 'selected' : '' %>>Dipinjam</option>
        <option value="rusak" <%= buku.status === 'rusak' ? 'selected' : '' %>>Rusak</option>
      </select>
    </div>
    <div class="field">
      <label for="tanggal_terbit">Tanggal Terbit</label>
      <input type="date" id="tanggal_terbit" name="tanggal_terbit" value="<%= buku.tanggal_terbit %>" required>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Perbarui Perubahan</button>
      <a href="/buku" class="btn btn-ghost">Batal</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>